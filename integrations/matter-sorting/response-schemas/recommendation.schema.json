{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["request_id", "correlation_id", "knowledge_version", "status", "candidates", "questions", "gaps"],
  "properties": {
    "request_id": {"type": "string"},
    "correlation_id": {"type": "string"},
    "knowledge_version": {"type": "string"},
    "status": {"type": "string"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "content", "candidate_status", "confidence", "evidence_refs", "knowledge_roles", "applicable_conditions", "differences", "risks"],
        "properties": {
          "candidate_id": {"type": "string"},
          "content": {"type": "string"},
          "candidate_status": {"type": "string", "enum": ["suggestion"]},
          "confidence": {"type": "number"},
          "evidence_refs": {"type": "array"},
          "knowledge_roles": {"type": "array"},
          "applicable_conditions": {"type": "array"},
          "differences": {"type": "array"},
          "risks": {"type": "array"}
        }
      }
    },
    "questions": {"type": "array"},
    "gaps": {"type": "array"}
  }
}
