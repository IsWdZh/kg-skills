{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["request_id", "correlation_id", "status", "knowledge_version", "evidence", "conflicts", "gaps", "trace"],
  "properties": {
    "request_id": {"type": "string"},
    "correlation_id": {"type": "string"},
    "status": {"type": "string", "enum": ["ok", "insufficient_evidence", "forbidden", "invalid_request"]},
    "knowledge_version": {"type": "string"},
    "external_object_id": {"type": ["string", "null"]},
    "evidence": {"type": "object"},
    "conflicts": {"type": "array"},
    "gaps": {"type": "array"},
    "trace": {"type": "object"}
  }
}
